---
import PageLayout from '../../layouts/PageLayout.astro';
import { SITE_URL } from '../../data/site-config';
import { route } from '../../i18n/routes';
import { breadcrumbSchema } from '../../lib/seo';
import { t } from '../../i18n/ui';
const lang = 'en';
const code = `<iframe src="${SITE_URL}/embed/family-tree-checker/" title="Citizenship by descent checker" width="100%" height="900" style="border:0;max-width:1000px" loading="lazy"></iframe>`;
---
<PageLayout title="Embed the citizenship by descent checker on your site" description="Show the free family tree checker for nineteen countries on a genealogy or heritage site: one iframe, no sign-up, no tracking, the data stays in your visitors' browser." lang={lang} noindex={true} jsonLd={[breadcrumbSchema([{ name: t(lang).breadcrumbHome, path: route('home', lang) }, { name: 'Embed', path: route('widget', lang) }])]} breadcrumbs={[{ label: 'Embed' }]} showAuthor={false}>
  <header class="mb-6">
    <h1 class="text-3xl font-bold text-navy-900 md:text-4xl">Embed the checker</h1>
    <p class="mt-3 text-lg text-navy-700">For a genealogy society, a library or a heritage association.</p>
  </header>
  <div class="prose prose-slate max-w-none">
    <pre class="overflow-x-auto rounded-lg bg-navy-900 p-4 text-sm text-white"><code>{code}</code></pre>
    <p>Keep the link under the frame visible. The checker is provided as it is, without warranty, and follows rule changes on its own. What your visitors type stays in their browser and no cookie is set. Questions: <a href={route('contact', lang)}>contact</a>.</p>
  </div>
  <div class="mt-8 overflow-hidden rounded-xl border border-navy-200"><iframe src="/embed/family-tree-checker/" title="Citizenship by descent checker" width="100%" height="900" style="border:0" loading="lazy"></iframe></div>
</PageLayout>
