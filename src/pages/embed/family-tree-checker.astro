---
/** Embeddable tool (iframe): no navigation, noindex, out of the sitemap (astro.config). */
import '../../styles/global.css';
import Tool from '../../components/Tool.astro';
import LicenceNotice from '../../components/LicenceNotice.astro';
import { SITE_URL, SITE_NAMES } from '../../data/site-config';
import { route } from '../../i18n/routes';
---
<!doctype html>
<html lang="en-US">
  <head>
    <meta charset="UTF-8" /><meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Citizenship by descent checker (widget)</title>
    <meta name="robots" content="noindex" />
    <link rel="canonical" href={`${SITE_URL}${route('home', 'en')}`} />
  </head>
  <body class="bg-white p-2 text-navy-900">
    <Tool tool={{ kind: 'checker', props: { country: 'it' } }} lang="en" primary={true} idPrefix="e" />
    <p class="mt-2 text-center text-xs text-navy-600"><a href={`${SITE_URL}${route('home', 'en')}`} target="_blank" rel="noopener" class="underline">{SITE_NAMES.en}</a>: independent site, not a government service. Not legal advice.</p>
    <LicenceNotice class="mt-2 text-center text-[11px] text-navy-600" />
  </body>
</html>
